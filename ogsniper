local entries={}; local eCnt=0; local ogCnt=0
local function updCount()
    local s=eCnt.." caught"; CntL.Text=s; SCaughtL.Text=s; SOGL.Text=ogCnt.." OG"
    SnipEmpty.Visible=(eCnt==0)
end

SnipClear.MouseButton1Click:Connect(function()
